import java.util.concurrent.locks.Condition;
import java.util.concurrent.locks.ReentrantLock;

class NumberPrinter {
    private int number = 1;
    private final ReentrantLock lock = new ReentrantLock();
    private final Condition condition = lock.newCondition(); // Condition created

    public void printOdd() {
        lock.lock();
        try {
            while (number <= 10) {
                if (number % 2 == 0) {
                    condition.await();  // Wait if number is even
                }

                System.out.println("Odd Thread: " + number);
                number++;

                condition.signal(); // Wake even thread
            }
        } catch(Exception e){
            e.printStackTrace();
        } finally {
            lock.unlock();
        }
    }

    public void printEven() {
        lock.lock();
        try {
            while (number <= 10) {
                if (number % 2 != 0) {
                    condition.await();  // Wait if number is odd
                }

                System.out.println("Even Thread: " + number);
                number++;

                condition.signal(); // Wake odd thread
            }
        } catch(Exception e){
            e.printStackTrace();
        } finally {
            lock.unlock();
        }
    }
}

public class ConditionExample {
    public static void main(String[] args) {
        NumberPrinter printer = new NumberPrinter();

        Thread t1 = new Thread(() -> printer.printOdd());
        Thread t2 = new Thread(() -> printer.printEven());

        t1.start();
        t2.start();
    }
}
